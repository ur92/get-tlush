VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Use 8888 with `npx netlify dev` (functions + Vite). Plain `yarn dev` on 5173 won't complete login.
VITE_OIDC_REDIRECT_URI=http://localhost:8888/callback
VITE_ANALYTICS_INGEST_URL=
# Local dev only: skip Google login and analytics (requires Vite dev server; off by default).
# VITE_DEV_NO_AUTH=true
